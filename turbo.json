{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#format:check:root": {
      "cache": false
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "build:chrome": {
      "outputs": ["dist/chrome-mv3/**"]
    },
    "bundle": {},
    "check-types": {},
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {},
    "format:check": {
      "dependsOn": ["//#format:check:root"]
    },
    "lint": {},
    "record": {
      "cache": false
    },
    "test": {},
    "test:e2e": {},
    "test:e2e:live": {
      "cache": false
    },
    "test:live": {
      "cache": false
    }
  },
  "ui": "tui"
}
