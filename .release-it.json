{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "requireBranch": "v2"
  },
  "github": {
    "assets": ["apps/webapp/out/*.zip", "apps/webextension/dist/*.zip"],
    "release": true,
    "releaseName": "${version}"
  },
  "hooks": {
    "after:bump": "npm run bundle",
    "after:release": "echo Successfully released ${name} v${version} to ${repo.repository}.",
    "before:init": ["npm run format", "npm run lint", "npm run check-types"]
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/bumper": {
      "out": ["apps/webapp/package.json", "apps/webextension/package.json"]
    },
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "section": "✨ Features",
            "type": "feat"
          },
          {
            "section": "🐛 Bug Fixes",
            "type": "fix"
          }
        ]
      }
    }
  }
}
