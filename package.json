{
  "name": "istrust",
  "version": "4.0.0",
  "description": "Verify the trustworthiness of any website",
  "homepage": "https://github.com/Internet-Society-Belgium/isTrust#readme",
  "bugs": {
    "url": "https://github.com/Internet-Society-Belgium/isTrust/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Internet-Society-Belgium/isTrust.git"
  },
  "author": {
    "name": "etoome",
    "url": "https://etoo.me/"
  },
  "type": "module",
  "workspaces": [
    "configs/*",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:webapp": "turbo build --filter=webapp",
    "build:webextension": "turbo build --filter=webextension",
    "bundle:webextension": "turbo bundle --filter=webextension",
    "check-types": "turbo check-types",
    "dev:webapp": "turbo dev --filter=webapp",
    "dev:webextension": "turbo dev --filter=webextension",
    "format": "prettier --write \"*.{js,ts,json}\" && turbo format",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "@istrust/prettier-config": "*",
    "prettier": "^3.2.5",
    "turbo": "^2.5.4"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0"
  }
}
