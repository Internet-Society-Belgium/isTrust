{
  "name": "@istrust/common",
  "version": "4.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "tsup --watch",
    "format": "prettier --write \"*.{js,ts,json}\" && prettier ./src --write",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@peculiar/x509": "^1.13.0",
    "dns-packet": "^5.6.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "eslint": "^9.33.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^3.2.2"
  }
}
