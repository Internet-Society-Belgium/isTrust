{
  "name": "@istrust/common",
  "version": "4.5.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "tsup --watch",
    "format": "prettier --write \"*.{js,ts,json}\" && prettier ./src --write",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnsquery/dns-packet": "^6.1.1",
    "@istrust/i18n": "*",
    "@peculiar/x509": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@istrust/eslint-config": "*",
    "@istrust/prettier-config": "*",
    "@istrust/typescript-config": "*",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
