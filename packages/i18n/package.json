{
  "name": "@istrust/i18n",
  "version": "4.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run generate:types && tsup",
    "check-types": "npm run generate:types && tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "npm run generate:types && tsup --watch",
    "format": "prettier --write \"*.{js,ts,json}\" && prettier ./src --write",
    "generate:types": "node ./scripts/generate_types.js",
    "lint": "npm run generate:types && eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@istrust/eslint-config": "*",
    "@istrust/prettier-config": "*",
    "@istrust/typescript-config": "*",
    "eslint": "^9.33.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
