{
  "name": "@istrust/ui",
  "version": "4.5.3",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "solid": "./dist/*.jsx",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:code && npm run build:styles",
    "build:code": "tsup",
    "build:styles": "npx @tailwindcss/cli -i ./src/styles.css -o ./dist/styles.css --minify",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "npm run dev:code & npm run dev:styles",
    "dev:code": "tsup --watch",
    "dev:styles": "npx @tailwindcss/cli -i ./src/styles.css -o ./dist/styles.css --minify --watch",
    "format": "prettier --write \"*.{js,ts,json}\" && prettier ./src --write",
    "generate:flags": "node ./scripts/generate_flags.js",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@istrust/i18n": "*"
  },
  "devDependencies": {
    "@istrust/common": "*",
    "@istrust/eslint-config": "*",
    "@istrust/prettier-config": "*",
    "@istrust/tailwind-config": "*",
    "@istrust/typescript-config": "*",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "solid-js": "^1.8.17"
  }
}
