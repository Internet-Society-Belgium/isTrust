{
  "name": "@istrust/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/styles.css",
    "./*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite build --watch --mode development",
    "format": "prettier --write \"*.{js,ts,json}\" && prettier ./src --write",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@istrust/common": "*",
    "@istrust/eslint-config": "*",
    "@istrust/prettier-config": "*",
    "@istrust/typescript-config": "*",
    "@tailwindcss/vite": "^4.1.11",
    "solid-js": "^1.8.17",
    "tailwindcss": "^4.1.11",
    "vite-plugin-solid": "^2.11.7"
  }
}
