    "@istrust/typescript-config": "*",
    "@tailwindcss/vite": "^4.1.8",
    "archiver": "^7.0.1",
    "eslint": "^9.16.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.3.3",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.10.2"
  }
