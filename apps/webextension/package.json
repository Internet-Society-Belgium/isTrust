{
  "name": "webextension",
  "version": "4.5.3",
  "type": "module",
  "scripts": {
    "bundle": "npm run bundle:chrome && npm run bundle:edge && npm run bundle:firefox",
    "bundle:chrome": "npm run generate:locales && wxt zip --browser chrome --mv3",
    "bundle:edge": "npm run generate:locales && wxt zip --browser edge --mv3",
    "bundle:firefox": "npm run generate:locales && wxt zip --browser firefox --mv2",
    "check-types": "npm run generate:locales && wxt prepare && tsc --noEmit",
    "clean": "rm -rf .turbo .wxt dist node_modules",
    "dev": "npm run dev:chrome",
    "dev:chrome": "npm run generate:locales && wxt --browser chrome",
    "dev:edge": "npm run generate:locales && wxt --browser edge",
    "dev:firefox": "npm run generate:locales && wxt --browser firefox",
    "format": "prettier --write \"*.{js,ts,json}\" && prettier ./src --write",
    "format:check": "prettier --check \"*.{js,ts,json}\" && prettier ./src --check",
    "generate:locales": "node ./scripts/generate_locales.js",
    "generate:xcode:ios": "wxt build --browser safari-ios --mv2 && node ./scripts/generate_xcode.js ios",
    "generate:xcode:macos": "wxt build --browser safari-macos --mv2 && node ./scripts/generate_xcode.js macos",
    "lint": "npm run generate:locales && wxt prepare && eslint src --max-warnings 0"
  },
  "dependencies": {
    "@istrust/common": "*",
    "@istrust/i18n": "*",
    "@istrust/ui": "*",
    "reflect-metadata": "^0.2.2",
    "solid-js": "^1.9.20"
  },
  "devDependencies": {
    "@istrust/eslint-config": "*",
    "@istrust/prettier-config": "*",
    "@istrust/tailwind-config": "*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.9",
    "@wxt-dev/auto-icons": "^2.0.0",
    "@wxt-dev/module-solid": "^1.1.4",
    "eslint": "^10.16.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wxt": "^0.21.5"
  }
}
