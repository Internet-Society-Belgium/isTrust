{
  "name": "webextension",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "bundle": "npm run bundle:chrome && npm run bundle:firefox && npm run bundle:safari",
    "bundle:chrome": "wxt zip -b chrome",
    "bundle:firefox": "wxt zip -b firefox",
    "bundle:safari": "wxt zip -b safari",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo .wxt dist node_modules",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "format": "prettier --write \"*.{js,ts,json}\" && prettier ./src --write",
    "postinstall": "wxt prepare",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@istrust/common": "*",
    "@istrust/ui": "*",
    "@webext-core/messaging": "^2.2.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@istrust/eslint-config": "*",
    "@istrust/prettier-config": "*",
    "@istrust/tailwind-config": "*",
    "@tailwindcss/vite": "^4.1.8",
    "@types/chrome": "^0.1.3",
    "@wxt-dev/auto-icons": "^1.0.2",
    "@wxt-dev/module-solid": "^1.1.2",
    "eslint": "^9.33.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.6.3",
    "wxt": "^0.20.7"
  }
}
