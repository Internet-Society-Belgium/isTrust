---
import Button from "@/components/button/index.astro";
import { getLangFromPath, getLocalizedPath } from "@/i18n";
import i18n from "@istrust/i18n";

const lang = getLangFromPath(Astro.url.pathname);
---

<div class="flex flex-col items-center justify-center gap-4 p-4">
  <nav class="flex flex-wrap justify-center gap-4">
    <Button href={getLocalizedPath(lang, "/legal")} redirect={true}>
      <span class="text-muted hover:underline">{i18n("Legal", lang)}</span
      ></Button
    >
    <Button href={getLocalizedPath(lang, "/privacy")} redirect={true}
      ><span class="text-muted hover:underline">{i18n("Privacy", lang)}</span
      ></Button
    >
  </nav>

  <div class="flex flex-col justify-center gap-2 text-center">
    <p class="text-muted">
      <span> 2021 © </span>
      <Button href="https://internetsociety.be/"
        ><span class="hover:underline"
          >Internet Society Chapter Belgium vzw/asbl</span
        >
      </Button>
    </p>
  </div>
</div>
