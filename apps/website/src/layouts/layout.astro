---
import Footer from "./footer.astro";
import Header from "./header.astro";
import LayoutMinimal from "./minimal.astro";
---

<LayoutMinimal>
  <header
    class="bg-background/75 border-border sticky top-0 z-100 border-b backdrop-blur"
  >
    <div class="mx-auto max-w-4xl">
      <Header />
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="border-border border-t">
    <div class="mx-auto max-w-4xl">
      <Footer />
    </div>
  </footer>
</LayoutMinimal>
