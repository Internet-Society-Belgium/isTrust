---
import Footer from "./footer.astro";
import Header from "./header.astro";
import "@/styles/global.css";
import { getLangFromPath } from "@/i18n";

const lang = getLangFromPath(Astro.url.pathname);
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>isTrust</title>
    <meta
      name="description"
      content="Verify the trustworthyness of any website"
    />
    <link rel="icon" type="image/x-icon" href="/images/icon.ico" />
    <link rel="icon" type="image/svg" href="/images/icon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/poster.png" />
  </head>
  <body class="bg-background flex min-h-screen flex-col justify-between">
    <header
      class="bg-background/75 border-border sticky top-0 z-100 border-b backdrop-blur"
    >
      <div class="mx-auto max-w-4xl">
        <Header />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-border border-t">
      <div class="mx-auto max-w-4xl">
        <Footer />
      </div>
    </footer>
  </body>
</html>
