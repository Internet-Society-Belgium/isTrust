---
import Button from "@/components/button/index.astro";
import {
  getLangFromPath,
  getLocalizedPath,
  getUnlocalizedPath,
  langs,
} from "@/i18n";

const unlocalizedPath = getUnlocalizedPath(Astro.url.pathname);
const lang = getLangFromPath(Astro.url.pathname);
---

<div class="flex h-20 items-center justify-between px-6 py-4">
  <Button href={getLocalizedPath(lang, "/")} redirect={true}>
    <div class="flex items-center justify-start gap-1">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="2em"
        height="2em"
        viewBox="0 0 135.467 135.467"
        data-copyright="Icon from isTrust - https://github.com/Internet-Society-Belgium/isTrust/blob/v2/LICENSE.md"
      >
        <path
          fill="none"
          stroke="#07f"
          stroke-width="21.167"
          d="M24.647 29.997c16.995-18.288 66.205-18.288 86.204 0 7.502 54.08-21.446 71.45-43.102 87.685-21.765-16.236-50.713-33.604-43.102-87.685Z"
        ></path>
      </svg>
      <span class="text-xl font-bold tracking-tight">isTrust</span>
    </div>
  </Button>

  <select
    onchange="window.location.pathname = this.options[this.selectedIndex].value"
    class="bg-elevated/50 border-border hover:bg-elevated hover:border-accented pointer-events-auto rounded-md border p-1 text-center text-sm hover:transition-colors"
  >
    {
      langs.map((l) => (
        <option
          value={getLocalizedPath(l, unlocalizedPath)}
          selected={l === lang}
        >
          {l.toUpperCase()}
        </option>
      ))
    }
  </select>
</div>
