---
import Button from "@/components/button/index.astro";
import {
  getLangFromPath,
  getLocalizedPath,
  getUnlocalizedPath,
  langs,
} from "@/i18n";

const unlocalizedPath = getUnlocalizedPath(Astro.url.pathname);
const lang = getLangFromPath(Astro.url.pathname);
---

<div class="flex h-20 items-center justify-between px-6 py-4">
  <Button href={getLocalizedPath(lang, "/")} redirect={true}>
    <div class="flex items-center justify-start gap-1">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="2em"
        height="2em"
        viewBox="0 0 135.467 135.467"
        data-copyright="Icon from isTrust - https://github.com/Internet-Society-Belgium/isTrust/blob/v2/LICENSE.md"
      >
        <path
          fill="none"
          stroke="#07f"
          stroke-width="21.167"
          d="M24.647 29.997c16.995-18.288 66.205-18.288 86.204 0 7.502 54.08-21.446 71.45-43.102 87.685-21.765-16.236-50.713-33.604-43.102-87.685Z"
        ></path>
      </svg>
      <span class="text-xl font-bold tracking-tight">isTrust</span>
    </div>
  </Button>

  <div class="relative">
    <select
      onchange="window.location.pathname = this.options[this.selectedIndex].value"
      class="bg-elevated/50 border-border hover:bg-elevated hover:border-accented pointer-events-auto w-full appearance-none rounded-md border py-1 pr-5 pl-2 text-sm transition-colors"
    >
      {
        langs.map((l) => (
          <option
            value={getLocalizedPath(l, unlocalizedPath)}
            selected={l === lang}
          >
            {l.toUpperCase()}
          </option>
        ))
      }
    </select>
    <svg
      class="pointer-events-none absolute top-2 right-1"
      xmlns="http://www.w3.org/2000/svg"
      width="1em"
      height="1em"
      viewBox="0 0 24 24"
      data-copyright="Icon from Lucide by Lucide Contributors - https://github.com/lucide-icons/lucide/blob/main/LICENSE"
    >
      <path
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m6 9l6 6l6-6"
      >
      </path>
    </svg>
  </div>
</div>
