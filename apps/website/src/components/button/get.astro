---
interface Props {
  id: string;
  href: string;
  style?: string;
}

const { id, href, style } = Astro.props;
---

<a
  id={id}
  class="bg-primary rounded-full px-4 py-3 font-semibold text-white shadow duration-200 hover:-translate-y-0.5 focus-visible:outline-offset-2"
  href={href}
  style={style}
  target="_blank"
>
  <slot />
</a>
