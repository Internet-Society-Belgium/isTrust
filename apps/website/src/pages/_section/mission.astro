---
import HeaderSection from "../../components/header/section.astro";
---

<div class="mx-auto max-w-4xl p-6">
  <HeaderSection header="Mission"> What set us apart </HeaderSection>

  <div class="mt-6 flex flex-wrap justify-center gap-6 p-6">
    <div class="ring-border flex w-60 rounded-lg ring">
      <div class="flex flex-col p-4">
        <h2 class="font-semibold">Free forever</h2>

        <p class="text-muted">Our tool is free to use without any charge</p>
      </div>
    </div>
    <div class="ring-border flex w-60 rounded-lg ring">
      <div class="flex flex-col p-4">
        <h2 class="font-semibold">Open source</h2>

        <p class="text-muted">
          The source code is available on <a
            href="https://github.com/Internet-Society-Belgium/isTrust/"
            target="_blank"
            class="underline">Github</a
          >
        </p>
      </div>
    </div>
    <div class="ring-border flex w-60 rounded-lg ring">
      <div class="flex flex-col p-4">
        <h2 class="font-semibold">Privacy friendly</h2>

        <p class="text-muted">
          The tool does not send any information back to us
        </p>
      </div>
    </div>
  </div>
</div>
