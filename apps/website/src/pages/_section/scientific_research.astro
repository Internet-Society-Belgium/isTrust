---
import { Image } from "astro:assets";
import he2bImage from "../../assets/academic/he2b.png";
import helbImage from "../../assets/academic/helb.png";
import rmaImage from "../../assets/academic/rma.png";
import uclouvainImage from "../../assets/academic/uclouvain.png";
import ulbImage from "../../assets/academic/ulb.png";
import unamurImage from "../../assets/academic/unamur.png";
import Button from "../../components/button/index.astro";
---

<div class="mx-auto flex max-w-4xl flex-wrap p-6">
  <div class="flex-1/2 p-12">
    <h2 class="text-4xl font-bold tracking-tight">Scientific research</h2>
    <p class="text-muted mt-1">
      The tool was developed following the concept introduced in a master thesis
      on the field of cyber security
    </p>

    <div class="mt-3">
      <a
        href="/Empower users to identify phishing websites.pdf"
        target="_blank"
        class="ring-accented bg-elevated hover:bg-accented/75 rounded-md px-3 py-2 text-sm font-medium text-nowrap ring ring-inset"
        >View document</a
      >
    </div>
  </div>

  <div class="flex flex-1/2 items-center justify-center p-6">
    <div class="flex flex-wrap items-center justify-center gap-4">
      <Button href="https://www.uclouvain.be/">
        <Image
          src={uclouvainImage}
          alt="Université catholique de Louvain"
          class="w-28 object-contain"
        />
      </Button>
      <Button href="https://www.ulb.be/">
        <Image
          src={ulbImage}
          alt="Université libre de Bruxelles"
          class="w-28 object-contain"
        />
      </Button>
      <Button href="http://www.unamur.be/">
        <Image
          src={unamurImage}
          alt="Université de Namur"
          class="w-28 object-contain"
        />
      </Button>
      <Button href="https://he2b.be/">
        <Image
          src={he2bImage}
          alt="Haute École Bruxelles-Brabant"
          class="w-28 object-contain"
        />
      </Button>
      <Button href="https://www.rma.ac.be/">
        <Image
          src={rmaImage}
          alt="Royal Military Academy"
          class="w-28 object-contain"
        />
      </Button>
      <Button href="https://www.helb-prigogine.be/">
        <Image
          src={helbImage}
          alt="HELB Ilya Prigogine"
          class="w-28 object-contain"
        />
      </Button>
    </div>
  </div>
</div>
