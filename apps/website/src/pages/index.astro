---
import { Image } from "astro:assets";
import { App } from "../components/app";
import { stores } from "../data/stores";
import Layout from "../layouts/layout.astro";
---

<Layout>
  <section class="relative p-8">
    <div
      class="absolute w-full inset-0 [background-size:20px_20px] [background-image:radial-gradient(#d4d4d4_1px,transparent_1px)] -z-1 [mask-image:radial-gradient(ellipse_at_center,transparent_20%,black)]"
    >
    </div>
    <div class="py-6 flex items-center flex-col">
      <div>
        <h2 class="text-5xl text-center">
          Verify the trustworthiness of any website
        </h2>
      </div>

      <div class="mt-6 flex gap-2 items-center">
        <a
          id="get-default"
          class="py-3 px-4 rounded-full bg-primary text-white shadow-2xs"
          href="#get"
        >
          <span> Get webextension</span>
        </a>
        {
          stores.entries().map((store) => (
            <a
              id={`get-${store[0]}`}
              class="py-3 px-4 flex items-center gap-2 rounded-full bg-primary text-white shadow-2xs"
              href={store[1].link}
              style="display: none;"
            >
              <div class="h-6 w-6">
                <Image
                  src={store[1].icon()}
                  alt={store[1].name}
                  loading="eager"
                />
              </div>
              <span>Get webextension</span>
            </a>
          ))
        }
        <script>
          function browser() {
            const ua = navigator.userAgent;

            if (ua.includes("Chrome") || ua.includes("Chromium")) {
              if (ua.includes("Edg")) return "edge";

              return "chrome";
            }
            if (ua.includes("Safari")) return "safari";

            if (ua.includes("Firefox")) return "firefox";
          }

          const getDefault =
            document.querySelector<HTMLAnchorElement>(`#get-default`);
          const getStore = document.querySelector<HTMLAnchorElement>(
            `#get-${browser()}`
          );

          if (getDefault !== null && getStore !== null) {
            getStore.style.display = "inherit";
            getDefault.style.display = "none";
          }
        </script>
      </div>
    </div>

    <div class="flex justify-center py-6 min-h-[500px]">
      <App client:load />
    </div>

    <section id="trailer" class="p-4">
      <!-- <video controls class="h-full w-full rounded-lg shadow-lg aspect-video">
        <source
          src="https://istrust.org/teaser/teaser-v0.8.mp4"
          type="video/mp4"
        />
        Your browser does not support this video
      </video> -->
    </section>

    <section
      id="get"
      class="mt-6 p-8 flex flex-col justify-center items-center"
    >
      <div class="text-center my-6">
        <h3>Get webextension</h3>
      </div>

      <div class="flex flex-wrap justify-center gap-10">
        {
          stores.values().map((store) => (
            <a
              href={store.link}
              class="ring-border bg-container hover:bg-container-darker pointer-events-auto flex items-center justify-center flex-col gap-1.5 rounded-md border-0 w-24 h-24 text-sm font-medium ring transition-colors ring-inset"
            >
              <div class="h-8 w-8">
                <Image src={store.icon()} alt={store.name} loading="eager" />
              </div>
              <p class="text-center">{store.name}</p>
            </a>
          ))
        }
      </div>
    </section>
  </section>
</Layout>
