---
import Layout from "../layouts/layout.astro";
import GetSection from "./_section/get.astro";
import HeroSection from "./_section/hero.astro";
import MissionSection from "./_section/mission.astro";
import ScientificResearchSection from "./_section/scientific_research.astro";
import TrailerSection from "./_section/trailer.astro";
---

<Layout>
  <section>
    <HeroSection />
  </section>

  <section
    id="trailer"
    class="border-border from-background border-t bg-gradient-to-b to-white"
  >
    <TrailerSection />
  </section>

  <section
    id="get"
    class="border-border from-background border-t bg-gradient-to-b to-white"
  >
    <GetSection />
  </section>

  <section
    id="mission"
    class="border-border from-background border-t bg-gradient-to-b to-white"
  >
    <MissionSection />
  </section>

  <section
    id="scientific-research"
    class="border-border from-background border-t bg-gradient-to-b to-white"
  >
    <ScientificResearchSection />
  </section>
</Layout>
