---
import { Image } from "astro:assets";
import { App } from "../components/app";
import { stores } from "../data/stores";
import Layout from "../layouts/layout.astro";
---

<Layout>
  <section class="p-8">
    <div class="flex flex-col items-center py-6">
      <div>
        <h2 class="flex flex-col items-center text-center text-5xl">
          <span> Verify the trustworthiness </span>
          <span> of any website </span>
        </h2>
      </div>

      <div class="mt-6 flex items-center gap-2">
        <a
          id="get-default"
          class="bg-primary rounded-full px-4 py-3 text-white shadow-2xs transition duration-200 hover:-translate-y-0.5"
          href="#get"
        >
          <span> Get webextension</span>
        </a>
        {
          stores.entries().map((store) => (
            <a
              id={`get-${store[0]}`}
              class="bg-primary flex items-center gap-2 rounded-full px-4 py-3 text-white shadow-2xs transition duration-200 hover:-translate-y-0.5"
              href={store[1].link}
              style="display: none;"
            >
              <div class="h-6 w-6">
                <Image
                  src={store[1].icon()}
                  alt={store[1].name}
                  loading="eager"
                />
              </div>
              <span>Get webextension</span>
            </a>
          ))
        }
        <script>
          function browser() {
            const ua = navigator.userAgent;

            if (ua.includes("Chrome") || ua.includes("Chromium")) {
              if (ua.includes("Edg")) return "edge";

              return "chrome";
            }
            if (ua.includes("Safari")) return "safari";

            if (ua.includes("Firefox")) return "firefox";
          }

          const getDefault =
            document.querySelector<HTMLAnchorElement>(`#get-default`);
          const getStore = document.querySelector<HTMLAnchorElement>(
            `#get-${browser()}`,
          );

          if (getDefault !== null && getStore !== null) {
            getStore.style.display = "inherit";
            getDefault.style.display = "none";
          }
        </script>
      </div>
    </div>

    <div class="flex min-h-[500px] justify-center py-6">
      <App client:load />
    </div>

    <section id="trailer" class="p-4">
      <!-- <video controls class="h-full w-full rounded-lg shadow-lg aspect-video">
        <source
          src="https://istrust.org/teaser/teaser-v0.8.mp4"
          type="video/mp4"
        />
        Your browser does not support this video
      </video> -->
    </section>

    <section
      id="get"
      class="mt-6 flex flex-col items-center justify-center p-8"
    >
      <div class="my-6 text-center">
        <h3>Get webextension</h3>
      </div>

      <div class="flex flex-wrap justify-center gap-10">
        {
          stores.values().map((store) => (
            <a
              href={store.link}
              class="ring-border bg-container hover:bg-container-darker pointer-events-auto flex h-24 w-24 flex-col items-center justify-center gap-1.5 rounded-md border-0 text-sm font-medium ring transition-colors ring-inset"
            >
              <div class="h-8 w-8">
                <Image src={store.icon()} alt={store.name} loading="eager" />
              </div>
              <p class="text-center">{store.name}</p>
            </a>
          ))
        }
      </div>
    </section>
  </section>
</Layout>
