---
import HeaderSection from "@/components/header/section.astro";
import { locales } from "@/i18n";
import Layout from "@/layouts/layout.astro";

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<Layout>
  {locale}
  <div class="mx-auto max-w-4xl p-12">
    <HeaderSection header="Privacy policy">
      Which personal data do we process
    </HeaderSection>

    <p class="m-6">
      As we want to protect your privacy,<span class="font-semibold"> NO </span>
      personal data is processed nor stored on this website. Similarly, <span
        class="font-semibold"
      >
        NO
      </span>
      cookie is used for tracking purposes.
    </p>

    <p class="m-6">
      In case of question related to privacy or data protection, please contact
      <a href="mailto:dpo@isoc.be" class="text-primary underline">dpo@isoc.be</a
      >
    </p>
  </div>
</Layout>
