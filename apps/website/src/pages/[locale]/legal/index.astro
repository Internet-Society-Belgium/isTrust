---
import HeaderSection from "@/components/header/section.astro";
import { locales } from "@/i18n";
import Layout from "@/layouts/layout.astro";

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<Layout>
  {locale}
  <div class="mx-auto max-w-4xl p-12">
    <HeaderSection header="Legal mention"> Who are we ? </HeaderSection>

    <p class="m-6">
      "istrust.org" is operated by Internet Society Chapter Belgium vzw/asbl
      (non-profit organization).
    </p>

    <p class="m-6">
      Our postal address is:
      <br />
      Internet Society Belgium
      <br />
      Notelaarstraat 285 | Rue du Noyer 285
      <br />
      1000 Brussels, Belgium
    </p>

    <p class="m-6">RPR/RPM Brussels: BE 0728.764.958</p>

    <p class="m-6">
      Our website address is:
      <a href="https://internetsociety.be" target="_blank" class="underline"
        >internetsociety.be</a
      >
    </p>
  </div>
</Layout>
