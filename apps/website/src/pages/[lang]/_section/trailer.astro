---
import HeaderSection from "@/components/header/section.astro";
import { getLangFromPath } from "@/i18n";
import i18n from "@istrust/i18n";

const lang = getLangFromPath(Astro.url.pathname);
---

<div class="mx-auto max-w-4xl p-12">
  <HeaderSection header={i18n("Trailer", lang)}
    >{i18n("Watch the video to learn more", lang)}</HeaderSection
  >

  <div class="mt-8">
    <video
      controls
      class="aspect-video h-full w-full rounded-lg shadow-lg"
      preload="none"
    >
      <source
        src="https://istrust.org/teaser/teaser-v0.8.mp4"
        type="video/mp4"
      />
      {i18n("Your browser does not support this video", lang)}
    </video>
  </div>
</div>
