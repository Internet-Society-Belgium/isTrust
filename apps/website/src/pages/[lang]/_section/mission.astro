---
import HeaderSection from "@/components/header/section.astro";
import { getLangFromPath } from "@/i18n";
import i18n from "@istrust/i18n";

const lang = getLangFromPath(Astro.url.pathname);
---

<div class="mx-auto max-w-4xl p-6">
  <HeaderSection header={i18n("Mission", lang)}
    >{i18n("What set us apart", lang)}
  </HeaderSection>

  <div class="mt-6 flex flex-wrap justify-center gap-6 p-6">
    <div class="ring-border flex w-60 rounded-lg ring">
      <div class="flex flex-col p-4">
        <h2 class="font-semibold">{i18n("Free forever", lang)}</h2>

        <p class="text-muted">
          {i18n("Our tool is free to use without any charge", lang)}
        </p>
      </div>
    </div>
    <div class="ring-border flex w-60 rounded-lg ring">
      <div class="flex flex-col p-4">
        <h2 class="font-semibold">{i18n("Open source", lang)}</h2>

        <p class="text-muted">
          {i18n("The source code is available on", lang)}
          <a
            href="https://github.com/Internet-Society-Belgium/isTrust/"
            target="_blank"
            class="underline">Github</a
          >
        </p>
      </div>
    </div>
    <div class="ring-border flex w-60 rounded-lg ring">
      <div class="flex flex-col p-4">
        <h2 class="font-semibold">{i18n("Privacy friendly", lang)}</h2>

        <p class="text-muted">
          {i18n("The tool does not send any information back to us", lang)}
        </p>
      </div>
    </div>
  </div>
</div>
