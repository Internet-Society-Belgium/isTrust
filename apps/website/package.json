{
  "name": "website",
  "version": "4.4.1",
  "type": "module",
  "scripts": {
    "build": "npm run generate:manifest && astro build",
    "bundle": "npm run build && node ./scripts/bundle.js",
    "clean": "rm -rf .turbo .astro dist node_modules",
    "dev": "astro dev",
    "format": "prettier --write \"*.{js,ts,json}\" && prettier ./src --write",
    "generate:assets": "pwa-assets-generator",
    "generate:manifest": "node ./scripts/generate_manifest.js",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@istrust/i18n": "*",
    "@istrust/ui": "*",
    "solid-js": "^1.9.7"
  },
  "devDependencies": {
    "@astrojs/solid-js": "^7.0.1",
    "@istrust/eslint-config": "*",
    "@istrust/prettier-config": "*",
    "@istrust/tailwind-config": "*",
    "@tailwindcss/vite": "^4.1.11",
    "@vite-pwa/assets-generator": "^1.0.0",
    "archiver": "^8.0.0",
    "astro": "^7.1.3",
    "eslint": "^10.0.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.11"
  }
}
